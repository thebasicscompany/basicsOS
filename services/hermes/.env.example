# ---- BasicsOS gateway (model routing; billing/usage central) ----
BASICSOS_GATEWAY_URL=https://api.basicsos.com   # dev: http://host.docker.internal:3001
BASICSOS_API_KEY=bos_live_sk_xxx                # dev: mint via gateway POST /dev/api-keys (see BUILD_PLAN_HERMES.md M1)

# ---- MCP Tool Broker (this company's packages/server) ----
BROKER_MCP_URL=http://host.docker.internal:3001/mcp
BROKER_INSTANCE_TOKEN=                          # instance/tenant credential for the Broker

# ---- hermes HTTP API server (how our backend drives chat) ----
API_SERVER_ENABLED=true
API_SERVER_KEY=                                 # shared bearer our backend sends
API_SERVER_HOST=0.0.0.0                         # internal to the Railway project in prod
API_SERVER_PORT=8642

# ---- State (mount on the durable volume) ----
HERMES_HOME=/opt/data

# ---- Auth: the API server is gated by API_SERVER_KEY, NOT the platform allowlist ----
GATEWAY_ALLOW_ALL_USERS=false
